# ═══════════════════════════════════════════════════════
#  RADAR-B3 — Variáveis de Ambiente do Backend
# ═══════════════════════════════════════════════════════
#
#  PASSO 1: Copie este arquivo:
#           cp .env.example .env
#
#  PASSO 2: Cole sua chave do Gemini abaixo
#           Obtenha grátis em: https://aistudio.google.com/app/apikey
#
#  ⚠️  NUNCA suba o arquivo .env para o GitHub!
#      (já está no .gitignore)
# ═══════════════════════════════════════════════════════

# Chave da API do Google Gemini (obrigatório)
GEMINI_API_KEY=

# Modelo Gemini a usar
# gemini-2.5-flash = rápido e gratuito (recomendado)
# gemini-2.5-pro   = mais preciso (pode ter custo)
GEMINI_MODEL=gemini-2.5-flash

# Porta do servidor Node.js
PORT=3001

# Habilitar busca na web em tempo real (true/false)
# true = Gemini busca dados atuais antes de responder (recomendado)
SEARCH_ENABLED=true

# Agendamento automático (cron) — formato: minuto hora dia mês diaSemana
# Padrão: Seg-Sex às 8h (horário de Brasília)
# Exemplos:
#   0 8 * * 1-5    = Seg-Sex 8h
#   0 8,18 * * 1-5 = Seg-Sex 8h e 18h
#   0 */6 * * *    = A cada 6 horas
CRON_SCHEDULE=0 8 * * 1-5
